GEMINI_API_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secret (never prefix with VITE_ — that would ship it to the browser).
# From Supabase: Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. From Upstash: create a Redis database -> REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay (PDF store payments). Test-mode keys work immediately, no KYC needed.
# From Razorpay dashboard: Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server-only. Encrypts the PDF store's per-purchase password at rest.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PDF_STORE_PASSWORD_ENC_KEY=

# Contact Admin support tickets. From Resend: dashboard -> API Keys.
# Free tier works out of the box with the default onboarding@resend.dev
# sender (no domain verification needed) as long as RESEND_FROM_EMAIL is left
# unset — tickets still get recorded in the admin inbox even without this.
RESEND_API_KEY=
# Optional — only needed once a sending domain is verified in Resend.
RESEND_FROM_EMAIL=
# The admin mailbox that receives a notification email for every new ticket.
ADMIN_NOTIFICATION_EMAIL=
