GEMINI_API_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave blank for local dev and the web build — API calls stay relative
# (/api/...) since the web app and API share an origin. Set this to the
# deployed API's origin (e.g. https://langmighty.vercel.app) only when
# building the Capacitor native app, which has no same-origin API to call.
VITE_API_BASE_URL=

# Server-only secret (never prefix with VITE_ — that would ship it to the browser).
# From Supabase: Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. From Upstash: create a Redis database -> REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
